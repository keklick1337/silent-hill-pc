# Writes a C++ file that embeds one shader as GLSL text and SPIR-V words.
# cmake -DGLSL=<file> -DSPIRV=<file.spv> -DSYMBOL=<name> -DOUT=<file.cpp> -P rhi_embed_shader.cmake
# Defines sh::rhi::embedded::<SYMBOL>() returning embedded::Shader (src/render/rhi/shaders/embedded.h).

file(READ "${GLSL}" _glsl_hex HEX)
file(READ "${SPIRV}" _spv_hex HEX)

string(LENGTH "${_spv_hex}" _spv_len)
math(EXPR _spv_rem "${_spv_len} % 8")
if(NOT _spv_rem EQUAL 0)
    message(FATAL_ERROR "${SPIRV}: size is not a multiple of 4")
endif()

# GLSL bytes as 0xNN, SPIR-V as little-endian 32-bit words.
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _glsl_bytes "${_glsl_hex}")
string(REGEX REPLACE "([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])"
       "0x\\4\\3\\2\\1u," _spv_words "${_spv_hex}")
# A GL-only build (no glslc) has an empty SPIR-V file: keep one word so the array is legal, report none.
set(_spv_count "sizeof(k${SYMBOL}Spirv) / sizeof(std::uint32_t)")
if(_spv_len EQUAL 0)
    set(_spv_words "0u,")
    set(_spv_count "0")
endif()

file(WRITE "${OUT}.tmp"
"// Generated by cmake/rhi_embed_shader.cmake from ${GLSL}. Do not edit.
#include \"render/rhi/shaders/embedded.h\"

namespace sh::rhi::embedded {
namespace {
const unsigned char k${SYMBOL}Glsl[] = {${_glsl_bytes} 0};
const std::uint32_t k${SYMBOL}Spirv[] = {${_spv_words}};
}  // namespace

Shader ${SYMBOL}() {
    return {std::string_view(reinterpret_cast<const char*>(k${SYMBOL}Glsl), sizeof(k${SYMBOL}Glsl) - 1),
            std::span<const std::uint32_t>(k${SYMBOL}Spirv, ${_spv_count})};
}

}  // namespace sh::rhi::embedded
")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
