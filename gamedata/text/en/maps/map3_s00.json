    "map3_s00.my_name_is_harry_mason": "{wait 3.4}My name is Harry Mason.\nI'm in town on vacation.{end}",
    "map3_s00.thank_god_another_human_being": "{wait1 2.8}Thank God.\nAnother human being.",
