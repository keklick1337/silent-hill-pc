    "map3_s00.have_you_seen_a_little": "{wait1 2.4}Have you seen\na little girl anywhere?",
    "map3_s00.im_looking_for_my_daughter": "{wait1 1.6}I'm looking for my daughter.",
    "map3_s00.shes_only_seven_short_black": "{wait1 3.0}She's only seven.\nShort, black hair.",
    "map3_s00.shes_missing_im_sorry": "{wait1 2.8}She's missing?\nI'm sorry.",
    "map3_s00.but_with_all_those_monsters": "{wait1 4.0}But with all those\nmonsters around,\nI highly doubt that she's...",
