  "quick": {
    "shadow_resolution": {
      "kind": "cycle",
      "setting": "shadow_resolution",
      "stored": [256, 512, 1024, 2048, 4096, 8192],
      "default_index": 2,
      "format": "size_square"
    },
    "widescreen_mode": {
      "kind": "cycle",
      "setting": "widescreen_mode",
      "label_table": "quick",
      "labels": ["Pillarbox", "Hor+", "Stretch"]
    },
    "audio_output": {
      "kind": "cycle",
      "setting": "audio_output",
      "label_table": "quick",
      "labels": ["Auto", "Stereo", "Quad", "5.1", "7.1"],
      "fallback": "HRTF"
    },
    "music_volume": {"kind": "volume", "setting": "music_volume", "max": 128, "step": 8, "format": "steps"},
    "effects_volume": {"kind": "volume", "setting": "effects_volume", "max": 128, "step": 8, "format": "steps"},
    "cutscene_line_gap_ms": {
      "kind": "cycle",
      "setting": "cutscene_line_gap_ms",
      "stored": [0, 150, 300, 600],
      "thresholds": [0, 220, 450],
      "label_table": "quick",
      "labels": [
        {"text": "Off", "table": "quick_menu"},
        "Short",
        "Normal",
        "Long"
      ]
    },
    "hero_light": {
      "kind": "cycle",
      "setting": "hero_light",
      "wrap": false,
      "label_table": "quick",
      "labels": [
        {"text": "Off", "table": "quick_menu"},
        "Low",
        "Medium",
        "High"
      ]
    },
    "crosshair_style": {
      "kind": "cycle",
      "setting": "crosshair_style",
      "mask": true,
      "label_table": "quick",
      "labels": ["Cross (+)", "Dot", "Circle", "Dashes"]
    },
    "auto_reload": {
      "kind": "cycle",
      "setting": "auto_reload",
      "label_table": "quick_menu",
      "labels": [
        "Off",
        "On",
        {"text": "Original", "table": "quick"}
      ],
      "fallback": "On"
    },
    "disable_dpad_movement": {
      "kind": "toggle",
      "setting": "disable_dpad_movement",
      "label_table": "quick_menu",
      "labels": ["Off", "On"]
    },
    "aim_resume_after_inventory": {
      "kind": "toggle",
      "setting": "aim_resume_after_inventory",
      "label_table": "quick_menu",
      "labels": ["Off", "On"]
    }
  }
